DEFAULT_MODEL_PROFILE=14b
# Gemma 4 26B-A4B (MoE, ~4B active) at 4-bit AWQ (compressed-tensors). On a 24 GB RTX 4090 this
# serves the model's full 262,144-token window with an fp8 KV cache (~370k tokens of KV) and image input.
# KV is paged and shared across the 4 sequence slots, so one near-full-context chat can run alongside short requests.
# Measured: ~170 tok/s decode on short prompts, ~105 tok/s at 254k context, ~4k tok/s prefill.
# (Gemma 4 31B dense AWQ was tried first: weights leave room for only ~33k tokens of context.)
MODEL_NAME=cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit
MODEL_ARGS=--gpu-memory-utilization 0.96 --max-model-len 262144 --kv-cache-dtype fp8 --enable-prefix-caching --enable-chunked-prefill --max-num-batched-tokens 4096 --max-num-seqs 4 --reasoning-parser gemma4 --limit-mm-per-prompt.image 4
MODEL_GPU_MEMORY_UTILIZATION=0.96
MODEL_MAX_MODEL_LEN=262144
MODEL_ENABLE_PREFIX_CACHING=1
MODEL_MAX_NUM_SEQS=4
MODEL_ENABLE_CHUNKED_PREFILL=1
MODEL_QUANTIZATION=
MODEL_TRUST_REMOTE_CODE=0
MODEL_ENFORCE_EAGER=0
MODEL_SWAP_SPACE=
MODEL_EXTRA_ARGS=--kv-cache-dtype fp8 --max-num-batched-tokens 4096 --reasoning-parser gemma4 --limit-mm-per-prompt.image 4
MODEL_14B_NAME=cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit
MODEL_14B_ARGS=--gpu-memory-utilization 0.96 --max-model-len 262144 --kv-cache-dtype fp8 --enable-prefix-caching --enable-chunked-prefill --max-num-batched-tokens 4096 --max-num-seqs 4 --reasoning-parser gemma4 --limit-mm-per-prompt.image 4
MODEL_14B_GPU_MEMORY_UTILIZATION=0.96
MODEL_14B_MAX_MODEL_LEN=262144
MODEL_14B_ENABLE_PREFIX_CACHING=1
MODEL_14B_MAX_NUM_SEQS=4
MODEL_14B_ENABLE_CHUNKED_PREFILL=1
MODEL_14B_QUANTIZATION=
MODEL_14B_TRUST_REMOTE_CODE=0
MODEL_14B_ENFORCE_EAGER=0
MODEL_14B_SWAP_SPACE=
MODEL_14B_EXTRA_ARGS=--kv-cache-dtype fp8 --max-num-batched-tokens 4096 --reasoning-parser gemma4 --limit-mm-per-prompt.image 4
